{
  "name": "lunara-labs",
  "version": "0.3.0",
  "private": true,
  "description": "Illustrated interactive learning labs with browser-local progress.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "test": "node --import tsx --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "audio:generate": "node scripts/generate-narration.mjs",
    "test:browser": "playwright test",
    "build": "tsc --noEmit && vite build && node scripts/check-build.mjs",
    "typecheck": "tsc --noEmit",
    "preview": "node scripts/serve.mjs",
    "format": "prettier --write src scripts tests *.mjs *.json .github/workflows/*.yml",
    "format:check": "prettier --check src scripts tests *.mjs *.json .github/workflows/*.yml"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
